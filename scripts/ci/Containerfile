FROM docker.io/library/archlinux:base
# Keep Qt and Quickshell on a tested package set; rolling upgrades can
# introduce Qt ABI mismatches and QML name collisions in the pinned shell.
ARG ARCH_SNAPSHOT=2026/10/06
RUN printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$ARCH_SNAPSHOT" > /etc/pacman.d/mirrorlist \
    && pacman -Syyuu --noconfirm --needed python quickshell sway jq git dbus ttf-dejavu \
    && pacman -Scc --noconfirm \
    && setcap -r /usr/bin/sway \
    && useradd --create-home tester
USER tester
WORKDIR /package
ENV QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software WLR_BACKENDS=headless WLR_RENDERER=pixman
ENTRYPOINT ["dbus-run-session", "--", "bash", "/package/scripts/ci/check-qml.sh"]
